import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import plotly.express as px
import plotly.graph_objects as go
import dash
from dash import dcc, html

data=pd.read_csv("iris.csv")
data.dropna(inplace=True)
data.drop_duplicates(inplace=True)

%matplotlib inline

# Initialize the Dash app
app = dash.Dash(__name__)

# Load the dataset
data = sns.load_dataset('iris')

# Layout (HTML structure)
app.layout = html.Div([
    html.H1("Interactive Dashboard", className="title"),
    html.Div([
        dcc.Dropdown(
            id='species-dropdown',
            options=[{'label': species, 'value': species} for species in data['species'].unique()],
            value='setosa',
            className="dropdown"
        ),
        dcc.Graph(id='scatter-plot', className="graph"),
        dcc.Graph(id='histogram', className="graph"),
        dcc.Graph(id='box-plot', className="graph"),
    ], className="container")
])

# Callback to update scatter plot based on selected species
@app.callback(
    dash.dependencies.Output('scatter-plot', 'figure'),
    [dash.dependencies.Input('species-dropdown', 'value')]
)
def update_scatter_plot(selected_species):
    filtered_data = data[data['species'] == selected_species]
    fig = px.scatter(filtered_data, x='sepal_length', y='petal_length', color='species')
    return fig

# Callback to update histogram based on selected species
@app.callback(
    dash.dependencies.Output('histogram', 'figure'),
    [dash.dependencies.Input('species-dropdown', 'value')]
)
def update_histogram(selected_species):
    filtered_data = data[data['species'] == selected_species]
    fig = px.histogram(filtered_data, x='sepal_length', color='species', nbins=20)
    return fig

# Callback to update box plot based on selected species
@app.callback(
    dash.dependencies.Output('box-plot', 'figure'),
    [dash.dependencies.Input('species-dropdown', 'value')]
)
def update_box_plot(selected_species):
    filtered_data = data[data['species'] == selected_species]
    fig = px.box(filtered_data, x='species', y='sepal_length', color='species')
    return fig

# Run the app
if __name__ == "__main__":
    app.run_server(debug=True)
